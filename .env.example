# URL privada consumida apenas pelo servidor. Em produção, configure-a na plataforma de deploy.
N8N_KATIA_AGENDA_URL=https://seu-n8n.exemplo/webhook/seu-webhook
# Senha para acessar /admin. Use uma senha longa e exclusiva.
ADMIN_PASSWORD=troque-por-uma-senha-longa-e-exclusiva
# Gere um valor aleatório longo (por exemplo: openssl rand -hex 32).
ADMIN_SESSION_SECRET=troque-por-um-segredo-aleatorio-longo
# Deve ser idêntico à variável de ambiente KATIA_ADMIN_SECRET do serviço n8n.
N8N_ADMIN_SECRET=troque-por-um-segredo-compartilhado-longo
PORT=3000
